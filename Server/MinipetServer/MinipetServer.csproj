<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <!-- 问题1 根因（2026-09-26 实锤）：SkiaSharp 3.119.0 元包依赖表只联动
         NativeAssets.macOS/Win32，Linux native 必须显式引用，否则 CI(linux)
         构建的镜像缺 libSkiaSharp.so → ThumbService 全 500（素材加载失败）。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="WzComparerR2.WzLib">
      <HintPath>lib/WzComparerR2.WzLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- E12/E13 出厂种子随 publish 进镜像（Dockerfile 只拷 /app/publish，不拷仓库 Server/ 源目录）：
         容器 ContentRoot=/app 下没有 Server/seed → Link 到输出根的 seed/，
         DeviceProfile.FindSeedRoot 的第二候选布局即此。字体三档 JSON ~4.2MB 是主要体积；
         默认装扮（新设备 provisioning）+ profile（导出视口）同源。 -->
    <Content Include="../seed/**/*"
             Link="seed/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
