# =====================================================================
# MiniPet-ESP32 部署配置（复制为 .env，与 docker-compose.yml 同目录）
# =====================================================================

# 对外访问端口（五位数，避开群晖常用低位端口段）。
# 改完后在 NAS 项目目录执行 docker compose up -d 重建生效（端口属部署层，
# 不在 appsettings/Web 设置页里；ESP32 配网页填 http://<NAS_IP>:此端口）。
MINIPET_PORT=38090
