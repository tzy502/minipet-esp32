# =============================================================
# MiniPet 固件通用默认（与具体板卡无关）
# 板级相关配置（185B 板级默认）在 sdkconfig.defaults.amoled185b
# =============================================================

# FreeRTOS tick = 1kHz：IMU 采样节拍 / 条带动画 / 消抖都需要 ms 级分辨率
CONFIG_FREERTOS_HZ=1000

# 性能优先（渲染 + QSPI 上传 + minimp3 解码都在设备端）
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# TF 卡挂 FATFS：素材包/清单文件名超过 8.3，启用长文件名（heap 工作缓冲）
# 注意符号名必须是 CONFIG_FATFS_LFN_HEAP（choice 成员）；曾错写成 _ENABLED 导致静默失效
CONFIG_FATFS_LFN_HEAP=y
# CONFIG_FATFS_LFN_NONE is not set

# 共享 I2C 五器件统一走 i2c_master 新 API（driver/i2c_master.h），
# 显式关闭旧版 driver/i2c.h 避免符号/中断冲突
CONFIG_I2C_ENABLE_LEGACY_DRIVERS=n

# 任务看门狗：喂狗点在渲染心跳（app/ 负责），保留默认监控
# CONFIG_ESP_TASK_WDT_TIMEOUT_S 默认 5s，够 30fps 心跳

# ---- 分区表（E11 双 OTA，见 partitions.csv）----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL 内存走系统堆（IDF 堆含 PSRAM 池），弃内置 64KB 池（启动崩溃：tlsf 空池）
CONFIG_LV_USE_STDLIB_MALLOC=1

# LVGL malloc → C 库（IDF 堆，含 PSRAM）
# 【2026-10-01 真机对账修复】本行原为转义写坏的一行（`...崩溃\ nCONFIG_LV_USE_CLIB_MALLOC=y`
# 把 CLIB 那行整个吞进注释），而下一行的 BUILTIN=n 写法对 kconfig 无效（`is not set`
# 只在已启用项上生效，未设置项不会因此变 n）→ 185B 的 active sdkconfig 落成
# BUILTIN=y + 内置池 64KB 常驻 BSS（map 实证 lv_mem_core_builtin.c.obj @0x10000），
# 白吃 64KB 内部 DRAM——这正是本板"内部堆 120KB / 最大块 3KB"与 216（186KB）
# 差距的 96%。现写法：显式三连（STDLIB=1 选 C 库档 + CLIB=y + BUILTIN=n）。
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_MEM_SIZE_KILOBYTES=0

# 堆破坏排查：全面毒化 + 分配失败即 abort
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
CONFIG_HEAP_ABORT_ON_ALLOC_FAIL=y

# 内部 RAM 抢救：>4KB 的 malloc 进 PSRAM（LVGL 等大缓冲曾占满 182KB 内部堆，httpd/任务栈全挤死）
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ---- LVGL 内置字体（菜单真实化 E7）：28 号标题 + 20 号菜单项 + 16 号提示 ----
# 仅改 defaults，主 sdkconfig 由主线程统一 regen 后生效；lvgl_bridge.c 内
# 以 #if LV_FONT_MONTSERRAT_xx 兜底：未 regen 时自动回退 TF FONT 包，可编译
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# ---- 任务看门狗（E14 定稿）：不 panic ----
# TWDT 超时只回调/报警，重启与熔断的决策权在 app/watchdog.c（三振：重启自愈 →
# 熔断待机）。若置 y：IDF panic 处理器会在渲染栈已损坏（正是卡死场景）时接管，
# 绕过 watchdog.c 的 NVS 计数与熔断路径 —— 与设计相反，且表现为不可控重启循环。
# 诊断期若确需 panic 回溯，临时改 y 并同步 watchdog.c（trigger_panic 跟随本项），
# 用完必须回 n：docs/technical-reference.md（本目录自持副本）「临时件清理清单」同源。
CONFIG_ESP_TASK_WDT_PANIC=n

# E11 OTA 真回滚（2026-09-27）：新固件能启动但坏了时由 bootloader 回滚旧分区。
# 已在 ota.c:164-168 / state_machine.c:372 调 esp_ota_mark_app_valid_cancel_rollback()。
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- E14 mDNS（服务端发现，见 main/net/mdns_discover.c）----
# espressif/mdns 组件自带 "mdns" 任务（默认栈 4096）与 16 条动作队列。
# 内部堆是本板最大约束（~112KB 且碎片化），mDNS 只用于启动时一次发现查询，
# 栈压到 3072 仍有余量（查询路径最深的是收包解析，无 TLS/无大 JSON）。
CONFIG_MDNS_TASK_STACK_SIZE=3072
# 发现结果只在日志里出现一次，不需要组件的详细输出
CONFIG_MDNS_ENABLE_DEBUG_PRINTS=n

# ---- E14 设备日志上报（main/app/logbuf.c + POST /api/device/log）----
# 环形缓冲在 PSRAM（32KB）；上报心跳与失败重传统一走 ESP_LOGD（默认级别下
# 静默，排障时可临时把 LOG_DEFAULT_LEVEL 调到 Debug —— 不改代码即可调）。
# 此处**不改** LOG_MAXIMUM_LEVEL：既有 events/驱动的 ESP_LOGD 依赖它（避免
# 「修 A 坏 B」，见 AGENTS 硬规矩 1）。

# 【内部堆腾挪 2026-09-27】WiFi 驱动发送缓冲池略缩容
# 起因：默认 16 动态 TX（每块 ~1.6KB）使启动末期内部堆只剩 ~1KB 最大连续块，
# AP 侧出现 `wifi:mem fail`，httpd 回包 `error in send : 113 (EHOSTUNREACH)`
# → 配网页只有响应头没有 body。
# 注意：**RX 缓冲不要动**。曾把 STATIC_RX 6→4 / DYNAMIC_RX 16→8 以省更多内存，
# 真机随即出现 `WiFi 断开 reason=2（认证失败）`——关联/DHCP 对 RX 缓冲敏感，
# 故 RX 回默认，只把 TX 从 16 收到 12（本设备并发连接极少）。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=5
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
# RX_BA_WIN 必须随 RX 缓冲一起收（≤DYNAMIC_RX 且 ≤2×STATIC_RX，否则
# esp_wifi 编译期 #error）：默认 32 > 12，全新 clone 首次生成 sdkconfig
# 必炸（根 sdkconfig 里手动调过 6，defaults 缺失 = 只救了旧构建）。
CONFIG_ESP_WIFI_RX_BA_WIN=6

# 【联网根因修复 2026-09-27】WiFi/lwIP 允许从 PSRAM 分配
# 真机实测硬证据：启动末期内部 DRAM 只剩 空闲 2231B / 最大连续块 2036B →
#   E lwip_arch: thread_sem_init: out of memory
#   E esp-tls: getaddrinfo() returns 202
#   W http: mp_http_tx_fail ESP_ERR_HTTP_CONNECT errno=105 phase=open（立刻失败，不是超时）
#   W wifi:m f auth → 1.0s 后 auth -> init (0x200) = reason=2
# 即：设备"连不上/被踢"的真因是**自己的内部堆分配不出 WiFi 认证帧与 socket**，
# 不是路由器。本板有 8MB PSRAM（几乎全空），让 lwIP/WiFi 的收发缓冲与 socket
# 结构去 PSRAM 取，内部 DRAM 只留必须的部分。
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 【方案 A · 内部 RAM 腾挪 2026-09-27】关闭 WiFi 驱动代码的 IRAM 驻留。
# 真机根因：内部 DRAM 的 99328B 段在 WiFi 驱动构造期就被 154 个分配块占满
# （`allocated 95956 / free 24`），运行期稳定只剩 ~2.3KB →
# `probe: socket 失败 errno=105 (lwIP ENOBUFS)` → 心跳/指令/BGM 断续，
# hello 要 22s 才成功。IRAM 驻留是为吞吐优化，本设备是哑终端（单连接、
# 几 KB/s 指令 + 一路 mp3 流），吞吐不是瓶颈，内部 RAM 才是。
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
